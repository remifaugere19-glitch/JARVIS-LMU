<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>JARVIS V196 · Centre de contrôle</title><style>
:root{--bg:#050d17;--panel:#091a2b;--line:#154766;--cyan:#37caff;--muted:#94b6c9;--green:#26dca1}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -10%,#143a55,#050b14 55%);font:14px 'Segoe UI',Arial,sans-serif;color:#e9f6ff}button,input,select{font:inherit}button{cursor:pointer}.app{max-width:1740px;margin:auto;padding:16px 20px 28px}.top{display:flex;align-items:center;gap:16px;margin-bottom:15px;flex-wrap:wrap}.brand{margin-right:auto;font-size:34px;font-weight:850;letter-spacing:3px;color:#d7f2ff;text-shadow:0 0 18px #008cf3}.brand small{font-size:15px;color:var(--cyan);letter-spacing:1px}.nav{display:flex;gap:6px;flex-wrap:wrap}.nav button,.btn{background:linear-gradient(#0b2237,#071322);border:1px solid #205a7e;color:#c9eaff;border-radius:7px;padding:12px 15px}.nav button.active,.nav button:hover,.btn:hover{border-color:#3bcaff;box-shadow:inset 0 0 16px #116ca955;color:white}.danger{background:linear-gradient(#b82236,#650e20);border:1px solid #f34d64;color:white;border-radius:7px;padding:14px;font-weight:800}.layout{display:grid;grid-template-columns:260px minmax(0,1fr) 300px;gap:12px}.panel{border:1px solid var(--line);border-radius:9px;background:linear-gradient(135deg,#0b1b2c,#071321);padding:15px;box-shadow:0 0 18px #0008;margin-bottom:12px}.panel h3{margin:0 0 14px;font-size:15px;color:var(--cyan);letter-spacing:.5px}.muted{color:var(--muted)}.small{font-size:12px}.status{display:flex;align-items:center;gap:8px;margin:12px 0}.dot{width:9px;height:9px;border-radius:50%;background:#e7a13e}.hero{position:relative;overflow:hidden;border:1px solid #1e6388;border-radius:10px;height:365px;background:#111}.hero img{width:100%;height:100%;object-fit:cover;object-position:center 62%}.hero:after{content:'';position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 25px #06101c}.hero-caption{position:absolute;top:18px;left:20px;background:#05121ac9;padding:10px 16px;border-left:3px solid var(--cyan);font-weight:800;letter-spacing:1px}.sessions{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.sessions button{padding:12px 3px}.sessions button.active{background:#104976;color:white;border-color:#38caff}.statrow{display:flex;justify-content:space-between;border-bottom:1px solid #18364b;padding:9px 0}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}.toggle-row{display:flex;align-items:center;gap:10px;border-bottom:1px solid #16354b;padding:10px 3px}.toggle-row span{flex:1}.switch{appearance:none;width:40px;height:23px;border-radius:15px;background:#31495b;position:relative;cursor:pointer;flex-shrink:0}.switch:after{content:'';position:absolute;top:3px;left:3px;width:17px;height:17px;border-radius:50%;background:white;transition:.18s}.switch:checked{background:#159bfa}.switch:checked:after{left:20px}.switch:disabled{opacity:.6;cursor:not-allowed}.field{display:flex;justify-content:space-between;gap:8px;align-items:center;margin:15px 0}.field input:not([type=checkbox]),.field select{background:#0a2338;color:white;border:1px solid #235572;border-radius:5px;padding:9px;min-width:0;max-width:175px}.field input[type=range]{width:135px}.notice{color:#d6b778;font-size:12px;line-height:1.5}.hidden{display:none}.section{margin-top:12px}.section h4{margin:18px 0 4px;color:#b6eaff}.actions{display:flex;gap:9px;flex-wrap:wrap}.save{background:#086a55;border-color:#11d9a6}.pill{border:1px solid #26628a;padding:5px 9px;border-radius:20px;color:#7ed9ff;font-size:11px}.hero-info{margin:10px 0 2px;color:#d2e8f5}.full{grid-column:1/-1}.sidebar-image{width:100%;border-radius:6px}.footer{color:#9db1c1;margin-top:12px;font-size:12px} @media(max-width:1200px){.layout{grid-template-columns:230px 1fr}.right{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.right .panel{margin:0}}@media(max-width:760px){.layout{display:block}.right{display:block}.hero{height:290px}.brand{font-size:26px}}
.test-btn{padding:6px 11px;font-size:12px;color:#6ed7ff;white-space:nowrap}.toggle-row .test-btn{margin-left:8px}.toggle-row span{min-width:0}.hero{height:365px}.sessions button{background:#10283d;color:#e6f5ff;border:1px solid #276084;border-radius:5px}.sessions button.active{background:#1162a0}.brand{font-size:34px}@media(min-width:1450px){.hero{height:390px}} </style></head><body><div class="app"><header class="top"><div class="brand">JARVIS <small>Imola V58 · V196</small><div class="small muted" style="letter-spacing:1px">ASSISTANT IA · SIM RACING</div></div><nav class="nav"><button class="active" data-page="accueil">⌂ Accueil</button><button data-page="annonces">◉ Annonces</button><button data-page="profil">♙ Profil & IA</button><button data-page="audio">♫ Audio</button><button data-page="ecran">▣ Écran</button><button data-page="systeme">⚙ Système</button></nav><button class="danger" id="crier">🔊 ATTENTION ÇA VA CRIER</button></header><div class="layout"><aside><div class="panel"><h3>◈ ÉTAT JARVIS</h3><div class="status"><i class="dot"></i> <span id="lmu-status">Connexion LMU non vérifiée</span></div><div class="status"><i class="dot"></i> <span id="engine-status-label">Moteur V196 non raccordé</span></div><div class="status"><i class="dot"></i> Troisième Œil non raccordé</div><p class="notice">Aucun état de course fictif n'est affiché.</p></div><div class="panel"><h3>⚑ MODE SESSION</h3><div class="sessions" id="sessions"><button data-session="Entraînement">Entraînement</button><button data-session="Qualifications">Qualifs</button><button data-session="Course">Course</button></div><p class="small muted">Profils de préférences séparés pour chaque session. <span id="live-session" class="small muted"></span></p></div><div class="panel"><h3>◈ INFORMATIONS COURSE</h3><div class="statrow"><span>Circuit</span><span class="muted" id="track-live">Non connecté</span></div><div class="statrow"><span>Voiture</span><span class="muted" id="car-live">Non connectée</span></div><div class="statrow"><span>Carburant</span><span class="muted">—</span></div><div class="statrow"><span>Position</span><span class="muted">—</span></div></div><div class="panel"><h3>◉ TROISIÈME ŒIL</h3><p class="muted small">État disponible après raccordement vérifié à V196.</p></div></aside><main><section id="accueil" class="page"><div class="hero"><img src="/voitures.png" alt="Trois voitures de course au Mans au coucher du soleil"><div class="hero-caption">LE MANS · JARVIS CONTROL CENTER</div></div><div class="panel section"><h3>◉ CENTRE DE CONFIGURATION</h3><div class="grid2"><div><div class="toggle-row"><span>Activer IA (préférence)</span><input class="switch" type="checkbox" id="ia"></div><p class="notice">Un bonjour personnalisé est prononcé lors de l’activation. Le moteur V196 reste indépendant.</p></div><div><h4>Raccourci vocal</h4><p class="muted">Le bouton rouge déclenche la phrase humoristique via la synthèse vocale Windows, sans toucher au moteur.</p></div></div></div></section><section id="annonces" class="page hidden"><div class="panel"><h3>◉ ANNONCES VOCALES · <span id="session-name">Course</span></h3><p class="notice">Les boutons TEST lisent une formulation de démonstration, sans télémétrie ni action en jeu. Certaines phrases proviennent de V196, les autres sont des exemples à valider. Les filtres en jeu restent partiellement raccordés ; alertes critiques protégées.</p><div class="toggle-row" style="border:1px solid #276084;padding:14px;border-radius:8px;margin-bottom:14px"><span><strong>Repères de freinage — entraînement</strong><br><small id="brake-note">Activables uniquement en entraînement ; toujours silencieux en qualifs et course.</small></span><input class="switch" type="checkbox" id="brake-practice"></div><div id="annonce-list"></div></div></section><section id="profil" class="page hidden"><div class="panel"><h3>♙ PROFIL & ACTIVATION IA</h3><div class="field"><label for="prenom">Ton prénom</label><input id="prenom" maxlength="60" placeholder="Rémi"></div><div class="actions"><button class="btn" id="test-bonjour">🔊 Tester le bonjour</button></div><p class="notice">Le bouton d’activation IA déclenche le bonjour personnalisé via la voix Windows. Il ne démarre pas le moteur V196.</p></div></section><section id="audio" class="page hidden"><div class="panel"><h3>♫ RÉGLAGES AUDIO</h3><div class="field"><label>Sortie casque / haut-parleurs</label><select id="sortie"></select></div><div class="field"><label>Microphone</label><select id="micro"></select></div><div class="field"><label>Volume souhaité</label><input type="range" min="0" max="100" id="volume"></div><p class="notice">Périphériques Windows détectés automatiquement. Le choix est enregistré ; le routage de la voix du moteur V196 reste à raccorder. <button class="btn" type="button" onclick="refreshHardware()">↻ Actualiser les périphériques</button><span id="hardware-feedback" class="small muted"></span></p></div></section><section id="ecran" class="page hidden"><div class="panel"><h3>▣ AFFICHAGE</h3><div class="field"><label>Écran souhaité</label><select id="moniteur"></select></div><div class="field"><label>Largeur souhaitée</label><input id="largeur" type="number" min="700"></div><div class="field"><label>Hauteur souhaitée</label><input id="hauteur" type="number" min="500"></div><p class="notice">Écran détecté automatiquement. La fenêtre sera positionnée sur l’écran choisi au prochain lancement. Aucune résolution Windows n’est modifiée.</p></div></section><section id="systeme" class="page hidden"><div class="panel"><h3>⚙ SYSTÈME & PROTECTION</h3><p>✓ Interface locale et hors ligne</p><p>✓ Aucun moteur V25 inclus</p><p>✓ Aucun fichier du moteur V196 modifié</p><p>✓ Préférences enregistrées uniquement dans le dossier de l'interface</p><p class="notice">Les réglages IA, annonces et périphériques restent à raccorder et à valider sur la version V196 réellement installée.</p></div></section><div class="panel"><h3>⌁ RACCOURCIS</h3><div class="actions"><button class="btn save" id="save">▣ Enregistrer les préférences</button><button class="btn" id="reload">↻ Recharger</button><span id="feedback" class="pill">Prêt</span></div></div></main><aside class="right"><div class="panel"><h3>♫ RÉGLAGES AUDIO</h3><div class="field"><span>Sortie</span><span class="muted small">Voir onglet Audio</span></div><div class="field"><span>Microphone</span><span class="muted small">Voir onglet Audio</span></div><div class="field"><span>Volume</span><span class="muted small">Préférence locale</span></div></div><div class="panel"><h3>▣ RÉGLAGES ÉCRAN</h3><p class="muted">Interface adaptable à la taille de la fenêtre.</p><p class="small muted">Image principale conservée en grand pour voir les trois voitures.</p></div><div class="panel"><h3>◈ ACTIVATION IA</h3><div class="toggle-row"><span>Intelligence artificielle</span><input type="checkbox" class="switch" id="ia2"></div><p class="notice">Interrupteur relié au lancement local de V196.</p></div><div class="panel"><h3>◈ SÉCURITÉ</h3><p class="small muted">Repères de freinage, MFD et fichiers maîtres non modifiés.</p></div></aside></div><div class="footer">JARVIS V196 · Interface de configuration indépendante · 100 % local · Le moteur actuel reste intact.</div></div><script>
const TEST_EXAMPLES={"Annonce point de freinage": "Freine au panneau cent cinquante.", "Repère visuel suivant": "Freine au début du quatrième rail à droite.", "Alerte freinage tardif": "Attention, tu arrives trop vite sur le freinage.", "Conseil freinage dégressif": "Relâche progressivement le frein en entrant dans le virage.", "Voiture à gauche": "Voiture à gauche, garde ta ligne.", "Voiture à droite": "Voiture à droite, garde ta ligne.", "Voiture lente devant": "Attention, voiture lente devant.", "Drapeau jaune": "Drapeau : reste attentif.", "Drapeau bleu": "Drapeau bleu, laisse passer la voiture plus rapide.", "Position dans la catégorie": "Exemple de position : tu es troisième de ta catégorie.", "Position générale": "Exemple de position : tu es dixième au général.", "Écart voiture devant": "Exemple : deux secondes avec la voiture devant.", "Écart voiture derrière": "Exemple : une seconde avec la voiture derrière.", "Dernier tour": "Exemple de chrono : dernier tour en deux minutes trois secondes.", "Meilleur tour": "Exemple de chrono : meilleur tour en deux minutes deux secondes.", "Carburant restant": "Exemple : il te reste vingt litres de carburant.", "Tours de carburant restants": "Exemple : il te reste cinq tours de carburant.", "Calcul essence arrivée": "L’essence ne semble pas suffisante jusqu’à la fin.", "Conseil arrêt BOX": "Il faudra rentrer aux stands pour terminer la course.", "Virtual Energy": "Exemple : énergie virtuelle à quarante-huit pour cent.", "Température pneus": "Exemple : le pneu avant gauche est trop chaud.", "Usure pneus": "Exemple : attention à l’usure des pneus arrière.", "Conseil pneus pluie": "La piste devient humide, surveille les pneus pluie.", "Changement météo": "La pluie est active, je réévalue la stratégie.", "Sous-virage": "Tu élargis la trajectoire à l’entrée du virage.", "Survirage": "L’arrière décroche à la remise des gaz.", "Blocage roues": "Tu bloques les roues au freinage.", "Intervention ABS": "L’ABS intervient souvent au freinage.", "Intervention TC": "Le contrôle de traction intervient à la sortie du virage.", "Répartition freinage": "On peut examiner la répartition de freinage.", "Erreur de pilotage": "Avant de modifier le setup, vérifions ton point de freinage.", "Conseil setup après trois tours": "Après trois tours, on comparera ton pilotage avant de toucher au setup.", "Réponse à Jarvis": "Je t’écoute, quelle information veux-tu ?", "Répéter dernière annonce": "Je répète ma dernière annonce.", "Conseils pédagogiques": "Essaie de freiner fort en ligne droite, puis de relâcher progressivement.", "Humour léger": "Promis, je ne commente pas chaque vibreur.", "Messages non prioritaires": "J’ai assez de données pour analyser ton pilotage.", "Annonces sortie des stands": "Sortie des stands, vérifie le trafic avant de rejoindre la piste."};const GROUPS={'Freinage':['Annonce point de freinage','Repère visuel suivant','Alerte freinage tardif','Conseil freinage dégressif'],'Course & trafic':['Voiture à gauche','Voiture à droite','Voiture lente devant','Drapeau jaune','Drapeau bleu','Position dans la catégorie','Position générale','Écart voiture devant','Écart voiture derrière','Dernier tour','Meilleur tour'],'Stratégie':['Carburant restant','Tours de carburant restants','Calcul essence arrivée','Conseil arrêt BOX','Virtual Energy','Température pneus','Usure pneus','Conseil pneus pluie','Changement météo'],'Ingénieur & setup':['Sous-virage','Survirage','Blocage roues','Intervention ABS','Intervention TC','Répartition freinage','Erreur de pilotage','Conseil setup après trois tours'],'Radio & dialogue':['Réponse à Jarvis','Répéter dernière annonce','Conseils pédagogiques','Humour léger','Messages non prioritaires','Annonces sortie des stands']};const protectedNames=new Set(['Voiture à gauche','Voiture à droite','Drapeau jaune']);const sessions=['Entraînement','Qualifications','Course'];const defaults=()=>({braking_landmarks_practice:true,ia:false,session:'Course',prenom:'',audio:{sortie:'Par défaut Windows',micro:'Par défaut Windows',volume:80},ecran:{moniteur:'Principal',largeur:1440,hauteur:900},phrases:Object.fromEntries(sessions.map(s=>[s,Object.fromEntries(Object.values(GROUPS).flat().map(p=>[p,true]))]))});let cfg=defaults();const $=id=>document.getElementById(id);function render(){document.querySelectorAll('[data-session]').forEach(b=>b.classList.toggle('active',b.dataset.session===cfg.session));$('session-name').textContent=cfg.session;$('brake-practice').checked=cfg.session==='Entraînement'&&cfg.braking_landmarks_practice!==false;$('brake-practice').disabled=cfg.session!=='Entraînement';$('prenom').value=cfg.prenom||'';$('ia').checked=$('ia2').checked=cfg.ia;for(const k of ['sortie','micro','volume'])$(k).value=cfg.audio[k];for(const k of ['moniteur','largeur','hauteur'])$(k).value=cfg.ecran[k];$('annonce-list').innerHTML='';for(const [group,items] of Object.entries(GROUPS)){let section=document.createElement('div');section.className='section';let h=document.createElement('h4');h.textContent=group;section.append(h);for(const name of items){let row=document.createElement('label');row.className='toggle-row';let span=document.createElement('span');span.textContent=name+(protectedNames.has(name)?' · Prioritaire':'');let cb=document.createElement('input');cb.type='checkbox';cb.className='switch';const landmark=['Annonce point de freinage','Repère visuel suivant'].includes(name);cb.checked=landmark?(cfg.session==='Entraînement'&&cfg.braking_landmarks_practice!==false):(protectedNames.has(name)||cfg.phrases[cfg.session]?.[name]!==false);cb.disabled=protectedNames.has(name)||landmark;cb.onchange=()=>{cfg.phrases[cfg.session][name]=cb.checked};let test=document.createElement('button');test.className='btn test-btn';test.textContent='🔊 TEST';test.type='button';test.title='Écouter un exemple vocal (simulation hors jeu)';test.onclick=()=>{const phrase=TEST_EXAMPLES[name];if(phrase)speak(phrase);else message('Aucun exemple disponible pour cette annonce')};row.append(span,cb,test);section.append(row)}$('annonce-list').append(section)}}$('brake-practice').onchange=()=>{cfg.braking_landmarks_practice=$('brake-practice').checked;render()};function sync(){cfg.prenom=$('prenom').value.trim().slice(0,60);cfg.ia=$('ia').checked;for(const k of ['sortie','micro'])cfg.audio[k]=$(k).value||'Par défaut Windows';cfg.audio.volume=Number($('volume').value);cfg.ecran.moniteur=$('moniteur').value||'Principal';for(const k of ['largeur','hauteur'])cfg.ecran[k]=$(k).value}function message(t){$('feedback').textContent=t}
async function speak(phrase){try{const r=await fetch('/speak',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'test',phrase})});if(!r.ok)throw Error();message('🔊 Test vocal envoyé')}catch{message('Voix Windows indisponible')}}
$('test-bonjour').onclick=()=>{sync();speak('Bonjour '+(cfg.prenom||'pilote')+', JARVIS est prête.')};document.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-page]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.page').forEach(x=>x.classList.toggle('hidden',x.id!==b.dataset.page))});document.querySelectorAll('[data-session]').forEach(b=>b.onclick=()=>{cfg.session=b.dataset.session;render();document.querySelector('[data-page="annonces"]').click()});['ia','ia2'].forEach(id=>$(id).onchange=async()=>{const desired=$(id).checked; $('ia').disabled=$('ia2').disabled=true; try {const r=await fetch('/ia-control',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:desired})});const j=await r.json();if(!j.ok)throw Error(j.error||'Commande impossible');cfg.ia=j.running;$('ia').checked=$('ia2').checked=cfg.ia;sync();if(desired && j.running){speak('Bonjour '+(cfg.prenom||'pilote')+', JARVIS est prête.')}message(j.message||'État mis à jour')}catch(e){$('ia').checked=$('ia2').checked=cfg.ia;message('Erreur : '+e.message)}finally{$('ia').disabled=$('ia2').disabled=false}});$('save').onclick=async()=>{sync();try{let r=await fetch('/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(cfg)});if(!r.ok)throw Error();message('✓ Préférences enregistrées')}catch{message('Erreur d’enregistrement')}};$('reload').onclick=()=>location.reload();$('crier').onclick=async()=>{try{let r=await fetch('/speak',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'crier'})});if(!r.ok)throw Error();message('🔊 Phrase envoyée à Windows')}catch{message('Synthèse vocale indisponible')}};fetch('/config').then(r=>r.json()).then(data=>{let d=defaults();cfg={...d,...data,braking_landmarks_practice:data.braking_landmarks_practice!==false,prenom:typeof data.prenom==='string'?data.prenom:d.prenom,audio:{...d.audio,...data.audio},ecran:{...d.ecran,...data.ecran},phrases:Object.fromEntries(sessions.map(s=>[s,{...d.phrases[s],...data.phrases?.[s]}]))};render();fetch("/engine-status").then(r=>r.json()).then(j=>{cfg.ia=!!j.running;$("ia").checked=$("ia2").checked=cfg.ia}).catch(()=>{})}).catch(()=>render());

function setHardwareOptions(id,items,selected,defaultText){const el=$(id);el.replaceChildren();const add=(v,t)=>{let o=document.createElement('option');o.value=v;o.textContent=t;el.append(o)};add('',defaultText);for(const item of items)add(item.id,item.name);if(selected&&!items.some(x=>x.id===selected))add(selected,'Déconnecté : '+selected.slice(0,65));el.value=selected||''}
async function refreshHardware(){const status=$('hardware-feedback');if(status)status.textContent=' Recherche Windows…';try{const r=await fetch('/hardware');if(!r.ok)throw Error('HTTP '+r.status);const h=await r.json();setHardwareOptions('sortie',h.audio_outputs,cfg.audio.sortie==='Par défaut Windows'?'':cfg.audio.sortie,'Par défaut Windows');setHardwareOptions('micro',h.audio_inputs,cfg.audio.micro==='Par défaut Windows'?'':cfg.audio.micro,'Par défaut Windows');setHardwareOptions('moniteur',h.monitors,cfg.ecran.moniteur==='Principal'?'':cfg.ecran.moniteur,'Écran principal');if(status)status.textContent=` ${h.audio_outputs.length} sorties, ${h.audio_inputs.length} micros, ${h.monitors.length} écrans`+(h.errors.length?' — '+h.errors.join(' ; '):'');}catch(e){if(status)status.textContent=' Détection indisponible : '+e.message}}
setTimeout(refreshHardware,200);

async function refreshLiveV196(){try{const response=await fetch('/engine-status',{cache:'no-store'});if(!response.ok)return;const j=await response.json();const hb=j.telemetry||null;
$('engine-status-label').textContent=j.running?'Moteur V196 actif'+(j.external?' (lancé séparément)':''):(j.startup&&['BLOCKED','ERROR','VOICE_PRESENT'].includes(j.startup.code)?j.startup.message:'Moteur V196 non détecté');
$('lmu-status').textContent=hb&&hb.lmu_connected?'Connexion LMU confirmée':'Connexion LMU non vérifiée';
$('track-live').textContent=hb&&hb.track?hb.track:'Non connecté';$('car-live').textContent=hb&&hb.vehicle?hb.vehicle:'Non connectée';
$('live-session').textContent=hb&&hb.session?'Session LMU réelle : '+hb.session:'';
if(hb&&hb.session){const raw=String(hb.session).toLowerCase();const actual=(raw.includes('practice')||raw.includes('entrain')||raw.includes('entraîn'))?'Entraînement':(raw.includes('qual'))?'Qualifications':(raw.includes('race')||raw.includes('course'))?'Course':null;
if(actual&&cfg.session!==actual){cfg.session=actual;render();}}
}catch(e){}}
setInterval(refreshLiveV196,2000);refreshLiveV196();
</script></body></html>
